<view class="search-page data-v-c10c040c"><view class="search-bar data-v-c10c040c"><view class="search-input-wrap data-v-c10c040c"><text class="search-icon data-v-c10c040c">🔍</text><input class="search-input data-v-c10c040c" type="text" placeholder="搜索菜品名称" confirm-type="search" bindconfirm="{{a}}" value="{{b}}" bindinput="{{c}}"/></view><view class="search-btn data-v-c10c040c" bindtap="{{d}}">搜索</view></view><view class="result-area data-v-c10c040c"><view wx:if="{{e}}" class="loading data-v-c10c040c"><text class="data-v-c10c040c">搜索中...</text></view><view wx:elif="{{f}}" class="empty data-v-c10c040c"><text class="data-v-c10c040c">未找到相关菜品</text></view><view wx:else class="product-list data-v-c10c040c"><view wx:for="{{g}}" wx:for-item="product" wx:key="g" class="product-item data-v-c10c040c" bindtap="{{product.h}}"><image class="product-img data-v-c10c040c" src="{{product.a}}" mode="aspectFill"/><view class="product-info data-v-c10c040c"><text class="product-name data-v-c10c040c">{{product.b}}</text><text class="product-desc data-v-c10c040c">{{product.c}}</text><text class="product-category data-v-c10c040c">分类：{{product.d}}</text><view class="product-bottom data-v-c10c040c"><text class="product-price data-v-c10c040c">¥{{product.e}}</text><text class="product-unit data-v-c10c040c">/{{product.f}}</text></view></view></view></view></view></view>